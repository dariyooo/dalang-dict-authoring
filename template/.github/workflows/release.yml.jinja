name: Release

on:
  push:
    tags: ["*"]

permissions:
  contents: write

jobs:
  ci:
    uses: dariyooo/dalang-dict-utils/.github/workflows/dict-ci.yml@{{ dalang_dict_utils_tag }}{% if node_version %}
    with:
      node-version: "{{ node_version }}"
{%- endif %}

  release:
    needs: ci
    uses: dariyooo/dalang-dict-utils/.github/workflows/dict-release.yml@{{ dalang_dict_utils_tag }}{% if node_version %}
    with:
      node-version: "{{ node_version }}"
{%- endif %}
